# Fresh four-lane desktop benchmark. Do not apply depth changes to an existing chain.
# Desktop saturation profile: 24 vCPU / 128 GB RAM / 2 TB disk, with the
# genesis validator and native load generator on the same host. The default
# CPU sets use complete SMT sibling pairs on a 12-core/24-thread desktop;
# verify them with `lscpu -e=CPU,NODE,SOCKET,CORE` before benchmarking.
# Compose profiles are introduced to deploy only necessary services
# Several comma-separated profiles may be specified. Available profiles:
# (leave empty if you want only genesis to be started, on port 40001/udp)
# - blockchain-explorer: enables default native TON blockchain explorer ion port 8080
# - lite-server: deploys external TON lite-server, by default one runs as embedded inside genesis container on port 40004 (tcp)
# - time-machine: deploys Time Machine service on port 8083
# - admin-portal: deploys admin portal service on port 8085
# - config-update: deploys config update web UI on port 8084
# - faucet: deploys faucet service to get coins to some special address on port 88
# - data: deploys service that generates some activity with TON wallets, Jettons and NFTs on port 99
# - validators-N: launches N validators in addition to genesis node
# - indexer: deploys TON Center API v3
# - indexer-minimal: deploys API v3 without trace classifier
# - ton-http-api-v2: deploys TON Center HTTP API v3
# - session-stats: deploys session-stats on port 18000
# - native-load-generator: runs persistent native load in a separate container
# Keep optional profiles disabled so a generic `docker compose up` cannot begin
# saturation traffic. Start session-stats and the generator explicitly after
# genesis is healthy; see README.md.
# Keep desktop volume names stable regardless of the checkout directory name.
COMPOSE_PROJECT_NAME=mylocalton-desktop
COMPOSE_PROFILES=

# September 9 A/B/B/A desktop winner: existing local CPU-specific images.
# Start with Compose --no-build --pull never; the registry launcher pulls/builds.
# These tags are local benchmark artifacts, not published production images.
TON_BRANCH=admission-local-be235e03
TON_IMAGE=mylocalton-ton

# Keep management, liteserver, Session Stats, and file endpoints private on
# the desktop.
LITESERVER_BIND_IP=127.0.0.1
MANAGEMENT_BIND_IP=127.0.0.1
UI_BIND_IP=127.0.0.1
SESSION_STATS_BIND_IP=127.0.0.1
FILE_SERVER_BIND_IP=127.0.0.1

# The empty default stores the validator database in Docker's named volume on
# the desktop's 2 TB disk. Set an existing absolute NVMe directory to bind-mount
# it instead; disk capacity and free space are managed outside Compose.
TON_DB_VAL0_HOST_DIR=

# Same-host baseline: 16 validator vCPU, 6 generator vCPU, 1 stats vCPU,
# and at least 1 vCPU of quota left for the desktop. The sets below keep sibling
# threads of each physical core together on the current host topology; Session
# Stats shares the final core with host work but is capped at one vCPU.
GENESIS_CPU_QUOTE=16
VALIDATOR_CPU_QUOTE=16
INDEXER_CPU_QUOTE=2
CLASSIFIER_CPU_QUOTE=2
GENESIS_CPUSET=0-7,12-19
NATIVE_LOAD_CPU_QUOTE=6
NATIVE_LOAD_CPUSET=8-10,20-22
NATIVE_LOAD_MEMORY_LIMIT=8g
SESSION_STATS_CPU_QUOTE=1
SESSION_STATS_CPUSET=11,23

# Genesis settings
HEALTHCHECK_INTERVAL=15s
# used to generate  external.global.config.json that allows remote users to connect to lite-server via public IP
EXTERNAL_IP=
# period of elections validators, sec
VALIDATION_PERIOD=1200
# generate only masterchain
MASTERCHAIN_ONLY=false
# verbosity level, 1 - error, 2 - warning, 3 - info, 4 - debug
GENESIS_VERBOSITY=1
VALIDATOR_VERBOSITY=1
# Log resource snapshots while long Fift zero-state commands are running.
GENESIS_HEARTBEAT_SECONDS=30
# enable embedded http server
EMBEDDED_FILE_HTTP_SERVER=false
EMBEDDED_FILE_HTTP_SERVER_PORT=8888
# Leave two genesis CPUs for database/network work. A 16 GiB CellDb cache and
# 1.5-million-message mempool retain headroom within the 128 GB desktop host.
CUSTOM_PARAMETERS="--state-ttl 315360000 --archive-ttl 315360000 -f /usr/share/ton/smartcont/ --session-logs /var/ton-work/db/log.session-stats --threads 14 --mempool-num 1500000 --celldb-in-memory --celldb-cache-size 17179869184 --disable-rocksdb-stats --disable-state-serializer --broadcast-speed-catchain 128"
CUSTOM_CONFIG_SMC_URL=
# tvm version capability
VERSION_CAPABILITIES=14
# Native signed runs and four payment lanes require a fresh zero state and
# matching validator/generator images; do not retrofit a different topology.
NATIVE_TRANSFER_RUNS_ENABLED=1
NATIVE_TRANSFER_RUNS_GLOBAL_VERSION=15
NATIVE_TRANSFER_RUNS_CAPABILITY=1024
# Fixed depth 2 gives four lanes for the desktop performance reference.
NATIVE_PAYMENT_LANES_ENABLED=1
NATIVE_PAYMENT_LANES_GLOBAL_VERSION=16
NATIVE_PAYMENT_LANES_CAPABILITY=2048
NATIVE_PAYMENT_LANE_DEPTH=2
NATIVE_PAYMENT_LANE_WALLET_RETRIES=128
NATIVE_PAYMENT_LANE_WALLET_PARALLELISM=12
 # read about other parameters here https://github.com/neodix42/mylocalton-docker/wiki/Genesis-setup-parameters
GLOBAL_ID=-217
MAX_VALIDATORS=1000
MAX_MAIN_VALIDATORS=100
MIN_VALIDATORS=1
MIN_STAKE=1000000
MAX_STAKE=1000000000
MAX_FACTOR=10
MIN_TOTAL_STAKE=10000
ELECTION_START_BEFORE=900
ELECTION_END_BEFORE=300
ELECTION_STAKE_FROZEN=180
ORIGINAL_VALIDATOR_SET_VALID_FOR=120
ACTUAL_MIN_SPLIT=2
MIN_SPLIT=2
MAX_SPLIT=2
CELL_PRICE=100000
CELL_PRICE_MC=1000000
GAS_PRICE=1000
GAS_PRICE_MC=10000
SIMPLE_FAUCET_INITIAL_BALANCE=1000000
HIGHLOAD_FAUCET_INITIAL_BALANCE=1000000
DATA_FAUCET_INITIAL_BALANCE=1000000
VALIDATOR_0_INITIAL_BALANCE=500000000
VALIDATOR_1_INITIAL_BALANCE=500000000
VALIDATOR_2_INITIAL_BALANCE=500000000
VALIDATOR_3_INITIAL_BALANCE=500000000
VALIDATOR_4_INITIAL_BALANCE=500000000
VALIDATOR_5_INITIAL_BALANCE=500000000
BIT_PRICE_PER_SECOND=1
CELL_PRICE_PER_SECOND=500
BIT_PRICE_PER_SECOND_MC=1000
CELL_PRICE_PER_SECOND_MC=500000
CRITICAL_PARAM_MIN_WINS=4
CRITICAL_PARAM_MAX_LOSSES=2
SIMPLEX_TARGET_RATE_MS=300
SIMPLEX_SLOTS_PER_LEADER_WINDOW=4
SIMPLEX_FIRST_BLOCK_TIMEOUT_MS=400
SIMPLEX_MAX_LEADER_WINDOW_DESYNC=700
# Saturation-only mode: produce the next candidate immediately. The Simplex
# Native basechain candidates are work-driven; masterchain pacing stays normal.
# For the basechain, target rate remains a failure/skip input, not block pacing.
TON_SIMPLEX_MAX_TPS=1
# Allow a full 9 MiB native candidate to collate before Simplex treats its
# leader as failed. Successful candidates still publish immediately.
TON_SIMPLEX_MAX_TPS_CANDIDATE_TIMEOUT_MS=8000

PROTO_VERSION=5

VALIDATORS_MASTERCHAIN_NUM=1
VALIDATORS_PER_SHARD=1

BLOCK_LIMIT_MULTIPLIER=1
BLOCK_SIZE_UNDERLOAD_KB=4096
# At the observed ~313 bytes/native transfer, 9 MiB permits roughly 30k native
# transfers before the soft byte limit. No block-interval assumption is made.
# Keep the hard cap below the current 10 MiB consensus block maximum.
BLOCK_SIZE_SOFT_KB=9216
BLOCK_SIZE_HARD_KB=9728
BLOCK_GAS_LIMIT_UNDERLOAD=2000000
BLOCK_GAS_LIMIT_SOFT=10000000
BLOCK_GAS_LIMIT_HARD=20000000

SPAM_RUN=0
SPAM_CHAINS=10
SPAM_HOPS=65535
SPAM_SPLIT_HOPS=7
SPAM_DURATION_MINUTES=300

NATIVE_SPAM_RUN=0
NATIVE_SPAM_MODE=pipeline
NATIVE_SPAM_SOURCES=1000
NATIVE_SPAM_DURATION_SECONDS=600
NATIVE_SPAM_ROUNDS=0
NATIVE_SPAM_AMOUNT=0.000000001
NATIVE_SPAM_FEE=0
NATIVE_SPAM_TOPUP_AMOUNT=10
NATIVE_SPAM_PARALLELISM=192
NATIVE_SPAM_TRANSFER_TIMEOUT_SECONDS=120
NATIVE_SPAM_CONFIRM_TIMEOUT_SECONDS=30
NATIVE_SPAM_TOPUP_TIMEOUT_SECONDS=180
NATIVE_SPAM_FORCE_TOPUP=0
# Log native genesis wallet progress after this many source/destination sets.
NATIVE_SPAM_GENESIS_PROGRESS_EVERY=256

NATIVE_SPAM_KEEP_ARTIFACTS=0
NATIVE_SPAM_CONFIRM_PARALLELISM=192
NATIVE_SPAM_CONFIRM_POLL_SECONDS=0.2
NATIVE_SPAM_CONFIRM_MODE=optimistic
NATIVE_SPAM_PROGRESS_INTERVAL_SECONDS=5

# Separate persistent load generator. Start it explicitly; normal Compose starts
# remain traffic-free:
# docker compose --env-file .env.desktop --profile native-load-generator up --build native-load-generator
NATIVE_LOAD_SOURCES=24576
NATIVE_LOAD_CONNECTIONS=10
NATIVE_LOAD_SIGNERS=6
# Keep at least one observed admission-RTT worth of work available; the old
# 32768 ceiling itself capped a ~1-second RTT run near 32k transfers/s.
NATIVE_LOAD_INFLIGHT=262144
# Batch enough messages to amortize liteserver round trips without creating a
# large head-of-line batch. Sweep this separately after the baseline is valid.
NATIVE_LOAD_SUBMIT_BATCH_SIZE=64
NATIVE_LOAD_SUBMIT_SOURCE_RUN_SIZE=1
# Source-signed 16-transfer parents, batched over persistent ADNL clients.
NATIVE_LOAD_NATIVE_TRANSFER_RUNS=1
NATIVE_LOAD_NATIVE_TRANSFER_RUN_SIZE=16
NATIVE_LOAD_NATIVE_RUN_BATCHING=1
NATIVE_LOAD_PAYMENT_LANE_DEPTH=2
NATIVE_LOAD_PAYMENT_LANE_READY_TIMEOUT_SECONDS=900
NATIVE_LOAD_PAYMENT_LANE_READY_POLL_SECONDS=2
NATIVE_LOAD_PAYMENT_LANE_READY_STABLE_OBSERVATIONS=2
NATIVE_LOAD_PAYMENT_LANE_LITESERVER_TIMEOUT_SECONDS=5
NATIVE_LOAD_SUBMIT_COALESCE_MS=20
NATIVE_LOAD_MAX_CANONICAL_BACKLOG=2097120
NATIVE_LOAD_MAX_SOURCE_CANONICAL_BACKLOG=128
NATIVE_LOAD_DURATION_SECONDS=600
NATIVE_LOAD_AMOUNT=0.000000001
NATIVE_LOAD_FEE=0
NATIVE_LOAD_START_NONCE=0
NATIVE_LOAD_QUERY_TIMEOUT_SECONDS=10
NATIVE_LOAD_REPORT_INTERVAL_SECONDS=1
# Unpaced bounded load; canonical proof-observed throughput is the result.
NATIVE_LOAD_TARGET_TPS=0
NATIVE_LOAD_RAMP_SECONDS=0
NATIVE_LOAD_WARMUP_SECONDS=60
# Ten minutes measured, 60 seconds warm-up, and up to 180 seconds drain;
# proof-checked initial nonce discovery adds setup time.
NATIVE_LOAD_DRAIN_TIMEOUT_SECONDS=180
# Cover ramp + warm-up + measurement + drain so an admitted nonce cannot
# expire while later nonces for that source are still queued.
NATIVE_LOAD_VALID_FOR_SECONDS=7200
NATIVE_LOAD_WORKERS=6
NATIVE_LOAD_MAX_RETRIES=3
NATIVE_LOAD_RETRY_BACKOFF_MS=10
NATIVE_LOAD_AUTO_NONCE=1
NATIVE_LOAD_ADAPTIVE_INFLIGHT=1
# AIMD starts at 32,768 logical transfers and is capped at 65,536.
NATIVE_LOAD_ADAPTIVE_INITIAL_RTT_SECONDS=0.5
NATIVE_LOAD_SOURCE_OFFSET=0
NATIVE_LOAD_FINALITY_POLL_SECONDS=10
NATIVE_LOAD_FINALITY_SAMPLE_SOURCES=256
NATIVE_LOAD_CANONICAL_POLL_SECONDS=0.25
NATIVE_LOAD_CANONICAL_QUERY_TIMEOUT_SECONDS=30
NATIVE_LOAD_CANONICAL_RETRY_LIMIT=5
NATIVE_LOAD_CANONICAL_RETRY_BACKOFF_SECONDS=0.25
NATIVE_LOAD_CANONICAL_RETRY_MAX_BACKOFF_SECONDS=5
NATIVE_LOAD_REPAIR_COOLDOWN_SECONDS=10
NATIVE_LOAD_CANONICAL_BLOCK_FOLLOWER=1

# Native signature/state workers share the validator scheduler pool.
TON_NATIVE_EXECUTOR_THREADS=8
# Keep the measured four-lane reference queue budget per shard and
# retain admitted native messages for longer than the full benchmark horizon.
TON_NATIVE_COLLATOR_QUEUE_LIMIT=18432
TON_NATIVE_MEMPOOL_MAX_TTL=7200

NATIVE_TPS_INTERVAL_SECONDS=10
NATIVE_TPS_WORKCHAIN=0
NATIVE_TPS_PRINT_LIMIT=1000000
NATIVE_TPS_LITE_TIMEOUT_SECONDS=10
NATIVE_TPS_LITESERVER_ADDR=127.0.0.1:40004
NATIVE_TPS_VERBOSE_BLOCKS=0
NATIVE_TPS_BACKFILL_BLOCKS=0
NATIVE_TPS_MAX_BLOCKS_PER_INTERVAL=1000

# faucet settings
# enable captcha to secure faucet
FAUCET_USE_RECAPTCHA=false
# google reCaptcha v2, required then FAUCET_USE_RECAPTCHA=true
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET=
# if true generates new addresses only in masterchain (-1)
FAUCET_MASTERCHAIN_ONLY=false
# expiration of faucet request, secs
FAUCET_REQUEST_EXPIRATION_PERIOD=30
# amount of toncoins to giveaway
FAUCET_SINGLE_GIVEAWAY=10

# data-generator settings
# period of activity generation
PERIOD=5

# ton-http-api settings
# log level, one of trace, debug, info, warning, error, critical
THACPP_LOG_LEVEL=warning
# log format (`tskv`, `ltsv`, `json`)
THACPP_LOG_FORMAT=json
# number of workers
THACPP_MAIN_WORKER_THREADS=2
THACPP_TONLIB_THREADS=2

# indexer settings
# postgres settings
POSTGRES_USER=postgres
POSTGRES_DB=ton_index
POSTGRES_PASSWORD=PostgreSQL1234
# postgres exposed port
POSTGRES_PUBLISH_PORT=5432
# number of events classifier workers
TON_CLASSIFIER_WORKERS=2
# masterchain block seqno for indexer to start with
TON_WORKER_FROM=1

# session-stats settings
SESSION_STATS_IMAGE=ghcr.io/neodix42/ton-session-stats:side
SESSION_STATS_HTTP_PORT=18000
SESSION_STATS_TITLE=Native TON sidechain session stats
# When TON_DB_VAL0_HOST_DIR is set, copy the same absolute path here and clear
# TON_WORK_DOCKER_VOLUME so session-stats reads the bind-mounted database.
TON_WORK_HOST_DIR=
SESSION_STATS_FILENAME=log.session-stats
HOST_FS_ROOT=/
# One or more Docker volume names containing active session stats files.
# Comma-separated values are supported.
TON_WORK_DOCKER_VOLUME=mylocalton-desktop_ton-db-val0
DOCKER_VOLUMES_HOST_DIR=/var/lib/docker/volumes
SESSION_STATS_DIR_HOST_DIR=
SESSION_STATS_ARCHIVE_DIR=
SESSION_STATS_SELF=local-validator
SESSION_STATS_WORK_TIME_STATS_BY_SOURCE_LIST=
SESSION_STATS_IMPORT_INTERVAL_SECONDS=5
SESSION_STATS_IMPORT_LAG_SECONDS=2
SESSION_STATS_IMPORT_LOOKBACK_SECONDS=1800
SESSION_STATS_PRIVATE_NET=true
SESSION_STATS_NATIVE_FAST_PATH=true
SESSION_STATS_NATIVE_WORKCHAIN=0
SESSION_STATS_ALLOW_UNCORRELATED_CANDIDATES=false
SESSION_STATS_VALIDATE_ACTUAL_WORK_TIME=true
SESSION_STATS_WORK_TIME_STATS_BY_SOURCE=true

MLT_IMAGE=mylocalton-genesis
MLT_DATA_IMAGE=ghcr.io/neodix42/mylocalton-docker-data
MLT_FAUCET_IMAGE=ghcr.io/neodix42/mylocalton-docker-faucet
MLT_CONFIG_UPDATE_IMAGE=ghcr.io/neodix42/mylocalton-docker-config-update
MLT_EXPLORER_IMAGE=ghcr.io/neodix42/mylocalton-docker-explorer
MLT_LITE_SERVER_IMAGE=ghcr.io/neodix42/mylocalton-docker-lite-server
MLT_TIME_MACHINE_IMAGE=ghcr.io/neodix42/mylocalton-docker-time-machine
MLT_ADMIN_PORTAL_IMAGE=ghcr.io/neodix42/mylocalton-docker-admin-portal

# Frozen desktop images: reuse throughout comparisons; no builds between arms.
NATIVE_LOAD_IMAGE=mylocalton-client:admission-local-be235e03
GENESIS_HEALTHCHECK_START_PERIOD=60m
NATIVE_SPAM_GENESIS_DESTINATIONS=1
TON_SIMPLEX_MAX_TPS_FINALIZE_RESERVE_MS=1000
NATIVE_LOAD_SUBMIT_MAX_QUERIES_PER_CLIENT=64
NATIVE_LOAD_RETRY_HORIZON_SECONDS=180
NATIVE_LOAD_ADAPTIVE_INITIAL_CWND=32768
NATIVE_LOAD_ADAPTIVE_MAX_CWND=65536
TON_NATIVE_ADMISSION_CONFIG_CACHE=1
TON_NATIVE_VALIDATION_SIGNATURE_THREADS=8
TON_NATIVE_CHECKPOINT_RETAIN_INGRESS=0
# Matched 600-second / 20-ms A/B/B/A: 60,039.59 vs 57,673.19 TPS (+4.10%).
# Other candidates had no demonstrated gain; physical/global defaults stay off.
TON_KEYRING_PREPARED_SIGNING=0
TON_NATIVE_ADMISSION_SHARD_SHARING=0
TON_NATIVE_ADMISSION_SNAPSHOT_REFRESH=0
TON_NATIVE_RECONCILIATION_PROFILE=1
TON_OVERLAY_LOCAL_SIGNATURE_REUSE=1
# Strict parent metadata projection: separate measured candidate, not yet selected.
TON_NATIVE_CANDIDATE_METADATA_PROJECTION=0
