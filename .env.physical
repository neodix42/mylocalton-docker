# Volatile RAM benchmark on a physical server with 48 logical CPUs.
# Use benchmark/physical-ram-docker.py; ordinary system Docker is not this test.
# A native Linux host with >=192 GiB currently available RAM is required by
# this preset (normally a dedicated 256 GiB or larger server). Fresh test state
# only: the runner never moves a live production database into RAM.
# All private Docker images, writable layers, volumes and logs use a bounded
# noswap tmpfs. Reboot/unmount loses that state; export results first.
NATIVE_RAM_ENABLED=1
NATIVE_RAM_ROOT=/mnt/mylocalton-ram
NATIVE_RAM_SIZE_GIB=96
NATIVE_RAM_RUNTIME_GIB=64
NATIVE_RAM_HOST_RESERVE_GIB=32
NATIVE_RAM_MIN_AVAILABLE_GIB=192
NATIVE_RAM_MIN_FREE_GIB=16
NATIVE_RAM_BOOTSTRAP_TIMEOUT_SECONDS=5400
# Separate run phases: preparation/readiness cannot consume report time.
# The generator phase adds its setup allowance, lane-readiness timeout and
# configured ramp/warmup/measurement/drain durations. These are upper bounds.
NATIVE_RAM_WRAPPER_SETUP_TIMEOUT_SECONDS=600
NATIVE_RAM_GENERATOR_SETUP_TIMEOUT_SECONDS=1800
NATIVE_RAM_REPORT_TIMEOUT_SECONDS=1800

# Separate RAM networks allow existing Docker services and the ordinary
# 172.28.1.0/24 MyLocalTon network to remain running. Change these together if
# preflight reports a real overlap with your host routes or Docker networks.
# MLT_NETWORK_PREFIX is three IPv4 octets; the Compose network is always /24.
MLT_NETWORK_PREFIX=10.203.1
MLT_NETWORK_NAME=mylocalton-ram-network
# Keep the owned bridge name: the launcher verifies it before starting services.
MLT_NETWORK_BRIDGE=tonram1
NATIVE_RAM_BRIDGE_CIDR=10.203.2.1/24
NATIVE_RAM_ADDRESS_POOL=10.204.0.0/16

# Server A can use the existing remote generator on server B. The explicit
# `run` command instead measures the local generator settings below.
# The validator may schedule on all host CPUs, with a 44-CPU time budget.
# This combines the earlier server CPU profile with unmeasured RAM storage.
# Use a matching disk control on the same server to isolate storage effects.
# The 16 GiB CellDb cache and live state need RAM in addition to tmpfs files.
# Compose profiles are introduced to deploy only necessary services
# Several comma-separated profiles may be specified. Available profiles:
# (leave empty if you want only genesis to be started, on port 40001/udp)
# - blockchain-explorer: enables default native TON blockchain explorer ion port 8080
# - lite-server: deploys external TON lite-server, by default one runs as embedded inside genesis container on port 40004 (tcp)
# - time-machine: deploys Time Machine service on port 8083
# - admin-portal: deploys admin portal service on port 8085
# - config-update: deploys config update web UI on port 8084
# - faucet: deploys faucet service to get coins to some special address on port 88
# - data: deploys service that generates some activity with TON wallets, Jettons and NFTs on port 99
# - validators-N: launches N validators in addition to genesis node
# - indexer: deploys TON Center API v3
# - indexer-minimal: deploys API v3 without trace classifier
# - ton-http-api-v2: deploys TON Center HTTP API v3
# - session-stats: deploys session-stats on port 18000
# - native-load-generator: runs persistent native load in a separate container
# Keep optional profiles disabled so a generic `docker compose up` cannot begin
# saturation traffic. Start session-stats and the generator explicitly after
# genesis is healthy; see README.md.
COMPOSE_PROJECT_NAME=mylocalton-desktop
COMPOSE_PROFILES=

# Follow the latest successful TON master registry image at operator startup.
# start-native-genesis.sh pulls it and builds both local wrappers from one digest.
# The exported generator and paired benchmark runs then reuse immutable IDs.
TON_BRANCH=master
NATIVE_LOAD_IMAGE=mylocalton-native-load-generator:master
TON_IMAGE=ghcr.io/corton-nommander/ton
TON_BUILD_PULL=true
# Public workflow images are portable. Measure this deployment separately from
# prior host-tuned desktop results; the preparation receipt records its revision.

# Host port bindings for this deployment. Review these independently of CPU
# sizing; the remote guide documents public liteserver/stats and private management.
LITESERVER_BIND_IP=0.0.0.0
MANAGEMENT_BIND_IP=0.0.0.0
UI_BIND_IP=0.0.0.0
SESSION_STATS_BIND_IP=0.0.0.0
FILE_SERVER_BIND_IP=0.0.0.0

# Named volumes are inside the dedicated RAM daemon's data root. Leave this
# empty: a host bind could reintroduce disk I/O or point at production state.
TON_DB_VAL0_HOST_DIR=

# Server A runs genesis and Session Stats; the saturation generator runs on B.
# Leave four CPU equivalents outside the validator budget for host services.
# Empty CPU sets remove the old 24-thread desktop affinity restriction and
# avoid assuming CPU numbering or SMT/NUMA topology on the 48-CPU server.
# Quotas are ceilings, not reserved cores or a guarantee of full CPU usage.
GENESIS_CPU_QUOTE=44
GENESIS_MEMORY_LIMIT=128g
# Equal memory and memory+swap limits disable container swap.
GENESIS_MEMORY_SWAP_LIMIT=128g
VALIDATOR_CPU_QUOTE=44
INDEXER_CPU_QUOTE=2
CLASSIFIER_CPU_QUOTE=2
GENESIS_CPUSET=
# These limits apply only to an explicitly started LOCAL Compose generator.
# B uses run-remote-load.sh --cpus/--memory/--workers/--signers instead.
NATIVE_LOAD_CPU_QUOTE=4
NATIVE_LOAD_CPUSET=
NATIVE_LOAD_MEMORY_LIMIT=8g
NATIVE_LOAD_MEMORY_SWAP_LIMIT=8g
SESSION_STATS_CPU_QUOTE=2
SESSION_STATS_MEMORY_LIMIT=8g
SESSION_STATS_MEMORY_SWAP_LIMIT=8g
SESSION_STATS_CPUSET=

# Genesis settings
HEALTHCHECK_INTERVAL=15s
# A brand-new 49,152-wallet zero state takes about 23 minutes on the reference
# desktop. Ignore health failures during that bounded bootstrap so Compose can
# wait for the same wrapper invocation instead of aborting after five minutes.
GENESIS_HEALTHCHECK_START_PERIOD=60m
GENESIS_HEALTHCHECK_RETRIES=20
# used to generate  external.global.config.json that allows remote users to connect to lite-server via public IP
EXTERNAL_IP=
# period of elections validators, sec
VALIDATION_PERIOD=1200
# generate only masterchain
MASTERCHAIN_ONLY=false
# verbosity level, 1 - error, 2 - warning, 3 - info, 4 - debug
GENESIS_VERBOSITY=1
VALIDATOR_VERBOSITY=1
# Log resource snapshots while long Fift zero-state commands are running.
GENESIS_HEARTBEAT_SECONDS=30
# enable embedded http server
EMBEDDED_FILE_HTTP_SERVER=false
EMBEDDED_FILE_HTTP_SERVER_PORT=8888
# Use 40 scheduler threads within the 44-CPU validator budget, allowing time
# for database/network and native helper threads. Chain parameters retain the
# earlier eight-lane profile; RAM storage is a separate, unmeasured treatment.
CUSTOM_PARAMETERS="--state-ttl 315360000 --archive-ttl 315360000 -f /usr/share/ton/smartcont/ --session-logs /var/ton-work/db/log.session-stats --threads 40 --mempool-num 1500000 --celldb-in-memory --celldb-cache-size 17179869184 --disable-rocksdb-stats --disable-state-serializer --broadcast-speed-catchain 128"
CUSTOM_CONFIG_SMC_URL=
# tvm version capability
VERSION_CAPABILITIES=14
# Source-signed native runs are enabled for the pinned benchmark images.
# Genesis activation requires a fresh zero state or a matching existing chain.
NATIVE_TRANSFER_RUNS_ENABLED=1
NATIVE_TRANSFER_RUNS_GLOBAL_VERSION=15
NATIVE_TRANSFER_RUNS_CAPABILITY=1024
# Eight native payment lanes use a fixed depth-3 topology. This is an
# unmeasured scaling treatment requiring a fresh matching zero state and
# wallets; it cannot reuse an existing four-lane database.
NATIVE_PAYMENT_LANES_ENABLED=1
NATIVE_PAYMENT_LANES_GLOBAL_VERSION=16
NATIVE_PAYMENT_LANES_CAPABILITY=2048
NATIVE_PAYMENT_LANE_DEPTH=3
# Each random key matches its required lane with probability 1/8. At 256
# attempts the per-wallet exhaustion probability is below 1.5e-15.
NATIVE_PAYMENT_LANE_WALLET_RETRIES=256
NATIVE_PAYMENT_LANE_WALLET_PARALLELISM=12
 # read about other parameters here https://github.com/neodix42/mylocalton-docker/wiki/Genesis-setup-parameters
GLOBAL_ID=-217
MAX_VALIDATORS=1000
MAX_MAIN_VALIDATORS=100
MIN_VALIDATORS=1
MIN_STAKE=1000000
MAX_STAKE=1000000000
MAX_FACTOR=10
MIN_TOTAL_STAKE=10000
ELECTION_START_BEFORE=900
ELECTION_END_BEFORE=300
ELECTION_STAKE_FROZEN=180
ORIGINAL_VALIDATOR_SET_VALID_FOR=120
ACTUAL_MIN_SPLIT=3
MIN_SPLIT=3
MAX_SPLIT=3
CELL_PRICE=100000
CELL_PRICE_MC=1000000
GAS_PRICE=1000
GAS_PRICE_MC=10000
SIMPLE_FAUCET_INITIAL_BALANCE=1000000
HIGHLOAD_FAUCET_INITIAL_BALANCE=1000000
DATA_FAUCET_INITIAL_BALANCE=1000000
VALIDATOR_0_INITIAL_BALANCE=500000000
VALIDATOR_1_INITIAL_BALANCE=500000000
VALIDATOR_2_INITIAL_BALANCE=500000000
VALIDATOR_3_INITIAL_BALANCE=500000000
VALIDATOR_4_INITIAL_BALANCE=500000000
VALIDATOR_5_INITIAL_BALANCE=500000000
BIT_PRICE_PER_SECOND=1
CELL_PRICE_PER_SECOND=500
BIT_PRICE_PER_SECOND_MC=1000
CELL_PRICE_PER_SECOND_MC=500000
CRITICAL_PARAM_MIN_WINS=4
CRITICAL_PARAM_MAX_LOSSES=2
SIMPLEX_TARGET_RATE_MS=300
SIMPLEX_SLOTS_PER_LEADER_WINDOW=4
SIMPLEX_FIRST_BLOCK_TIMEOUT_MS=500
SIMPLEX_MAX_LEADER_WINDOW_DESYNC=700
# Saturation-only mode: native basechain candidates are work-driven and each
# successful candidate publishes immediately; masterchain pacing stays normal.
# For the basechain, target rate remains a failure/skip input, not block pacing.
TON_SIMPLEX_MAX_TPS=1
# The max-TPS local-work budget is 80% of this outer timeout. Eight seconds
# gives 6.4 seconds of local work plus 1.6 seconds for consensus/finalization.
TON_SIMPLEX_MAX_TPS_CANDIDATE_TIMEOUT_MS=8000
# Request a nominal final 1.0-second sealing interval inside the 6.4-second
# local-work budget. With the 100 ms fragment-start guard, new-fragment intake
# stops at 5.3 seconds; an already-running fragment remains non-preemptible.
# This is not outer-minus-1s.
TON_SIMPLEX_MAX_TPS_FINALIZE_RESERVE_MS=1000

PROTO_VERSION=5

VALIDATORS_MASTERCHAIN_NUM=1
VALIDATORS_PER_SHARD=1

BLOCK_LIMIT_MULTIPLIER=1
BLOCK_SIZE_UNDERLOAD_KB=4096
# The first 4k cycle observed a 10,585,196-byte candidate crossing the 10 MiB
# consensus cap because the preliminary estimator undercounted final BoC size.
# Keep 512 KiB between soft and hard limits and 1 MiB between the configured
# hard limit and consensus maximum while the exact serialized guard remains
# authoritative.
BLOCK_SIZE_SOFT_KB=8704
BLOCK_SIZE_HARD_KB=9216
BLOCK_GAS_LIMIT_UNDERLOAD=2000000
BLOCK_GAS_LIMIT_SOFT=10000000
BLOCK_GAS_LIMIT_HARD=20000000

SPAM_RUN=0
SPAM_CHAINS=10
SPAM_HOPS=65535
SPAM_SPLIT_HOPS=7
SPAM_DURATION_MINUTES=300

NATIVE_SPAM_RUN=0
NATIVE_SPAM_GENESIS_DESTINATIONS=1
NATIVE_SPAM_MODE=pipeline
NATIVE_SPAM_SOURCES=1000
NATIVE_SPAM_DURATION_SECONDS=600
NATIVE_SPAM_ROUNDS=0
NATIVE_SPAM_AMOUNT=0.000000001
NATIVE_SPAM_FEE=0
NATIVE_SPAM_TOPUP_AMOUNT=10
NATIVE_SPAM_PARALLELISM=192
NATIVE_SPAM_TRANSFER_TIMEOUT_SECONDS=120
NATIVE_SPAM_CONFIRM_TIMEOUT_SECONDS=30
NATIVE_SPAM_TOPUP_TIMEOUT_SECONDS=180
NATIVE_SPAM_FORCE_TOPUP=0
# Log native genesis wallet progress after this many source/destination sets.
NATIVE_SPAM_GENESIS_PROGRESS_EVERY=256

NATIVE_SPAM_KEEP_ARTIFACTS=0
NATIVE_SPAM_CONFIRM_PARALLELISM=192
NATIVE_SPAM_CONFIRM_POLL_SECONDS=0.2
NATIVE_SPAM_CONFIRM_MODE=optimistic
NATIVE_SPAM_PROGRESS_INTERVAL_SECONDS=5

# Ten-minute LOCAL saturation measurement with proof-checked signed runs.
# These do not configure server B: its exported remote-load.env and command
# line select its independent workload. Record which generator was measured.
# Ordinary Compose starts remain traffic-free.
NATIVE_LOAD_SOURCES=24576
NATIVE_LOAD_CONNECTIONS=10
NATIVE_LOAD_SIGNERS=6
# Keep at least one observed admission-RTT worth of work available; the old
# 32768 ceiling itself capped a ~1-second RTT run near 32k transfers/s.
NATIVE_LOAD_INFLIGHT=262144
# Cycle 4 averaged only 3.17 messages per 64-message wire batch and generated
# 1.08M liteserver queries for 3.42M attempts. A 20ms coalescing window is still
# below the measured 50ms median admission RTT, but should cut query/state-pin
# amplification substantially without creating a material latency tail.
NATIVE_LOAD_SUBMIT_BATCH_SIZE=64
NATIVE_LOAD_SUBMIT_SOURCE_RUN_SIZE=16
# The local generator matches the eight-lane chain. The native lane sweep or
# remote client preset supplies its own workload settings.
NATIVE_LOAD_NATIVE_TRANSFER_RUNS=1
NATIVE_LOAD_NATIVE_TRANSFER_RUN_SIZE=16
NATIVE_LOAD_NATIVE_RUN_BATCHING=1
NATIVE_LOAD_PAYMENT_LANE_DEPTH=3
# Three split rounds must reach the exact eight-leaf topology before load.
NATIVE_LOAD_PAYMENT_LANE_READY_TIMEOUT_SECONDS=1800
NATIVE_LOAD_PAYMENT_LANE_READY_POLL_SECONDS=2
NATIVE_LOAD_PAYMENT_LANE_READY_STABLE_OBSERVATIONS=2
NATIVE_LOAD_PAYMENT_LANE_LITESERVER_TIMEOUT_SECONDS=5
# Bounds fresh signer-completion waiting for scalar batches and opt-in NTRN
# batching on coalescer-capable images; a full batch may be released earlier.
NATIVE_LOAD_SUBMIT_COALESCE_MS=20
# Bound physical RPC fanout and logical canonical debt independently.
NATIVE_LOAD_SUBMIT_MAX_QUERIES_PER_CLIENT=64
NATIVE_LOAD_MAX_CANONICAL_BACKLOG=2097120
NATIVE_LOAD_MAX_SOURCE_CANONICAL_BACKLOG=128
NATIVE_LOAD_DURATION_SECONDS=600
NATIVE_LOAD_AMOUNT=0.000000001
NATIVE_LOAD_FEE=0
NATIVE_LOAD_START_NONCE=0
NATIVE_LOAD_QUERY_TIMEOUT_SECONDS=10
NATIVE_LOAD_REPORT_INTERVAL_SECONDS=1
# Zero requests bounded unpaced load; the generator starts only explicitly.
NATIVE_LOAD_TARGET_TPS=0
NATIVE_LOAD_RAMP_SECONDS=0
NATIVE_LOAD_WARMUP_SECONDS=60
# Ten minutes measured, plus warmup, nonce discovery and bounded drain.
NATIVE_LOAD_DRAIN_TIMEOUT_SECONDS=180
# Cover ramp + warm-up + measurement + drain so an admitted nonce cannot
# expire while later nonces for that source are still queued.
NATIVE_LOAD_VALID_FOR_SECONDS=7200
NATIVE_LOAD_WORKERS=6
# Generic transient failures use short exponential retry cycles. Exhaustion is
# governed by the elapsed source-head horizon below, not this attempt count.
NATIVE_LOAD_MAX_RETRIES=8
NATIVE_LOAD_RETRY_BACKOFF_MS=100
# Retry exhaustion is elapsed-time based. Keep more than twice the longest
# 31.5-second consensus pause observed in Cycle 2 so a transient catchain tail
# cannot permanently quarantine an otherwise recoverable source. Exact
# canonical-state lag has its own bounded backoff and does not collapse AIMD.
NATIVE_LOAD_RETRY_HORIZON_SECONDS=90
NATIVE_LOAD_CANONICAL_STATE_LAG_RETRY_BACKOFF_MS=250
NATIVE_LOAD_CANONICAL_STATE_LAG_RETRY_MAX_BACKOFF_MS=2000
NATIVE_LOAD_AUTO_NONCE=1
NATIVE_LOAD_ADAPTIVE_INFLIGHT=1
# Keep the admission window large enough to exercise the storage treatment.
# Signed-parent credit and logical output backlog remain separate limits.
NATIVE_LOAD_ADAPTIVE_INITIAL_RTT_SECONDS=0.05
NATIVE_LOAD_ADAPTIVE_INITIAL_CWND=32768
NATIVE_LOAD_ADAPTIVE_MAX_CWND=65536
NATIVE_LOAD_SOURCE_OFFSET=0
NATIVE_LOAD_FINALITY_POLL_SECONDS=10
NATIVE_LOAD_FINALITY_SAMPLE_SOURCES=256
NATIVE_LOAD_CANONICAL_POLL_SECONDS=0.25
NATIVE_LOAD_CANONICAL_QUERY_TIMEOUT_SECONDS=30
NATIVE_LOAD_CANONICAL_RETRY_LIMIT=5
NATIVE_LOAD_CANONICAL_RETRY_BACKOFF_SECONDS=0.25
NATIVE_LOAD_CANONICAL_RETRY_MAX_BACKOFF_SECONDS=5
NATIVE_LOAD_REPAIR_COOLDOWN_SECONDS=10
NATIVE_LOAD_CANONICAL_BLOCK_FOLLOWER=1

# Ingress verifier actors share the scheduler; parallel execution helpers can
# also create native threads. Keep this count fixed while measuring CPU scaling.
TON_NATIVE_EXECUTOR_THREADS=8
# NTRN block-signature fanout only; screen 1/2/4/8 without changing admission workers.
TON_NATIVE_VALIDATION_SIGNATURE_THREADS=8
# Default-off process-lifetime executor experiment; compare 0/1 with fanout fixed.
TON_NATIVE_VALIDATION_SIGNATURE_PERSISTENT_POOL=0
# Experimental positive-cache shortcut; retain control until repeatable promotion.
TON_NATIVE_VALIDATION_SIGNATURE_CACHE_FASTPATH=0
# Retain canonical NTRN roots and omit expanded execution vectors; benchmark before enabling.
TON_NATIVE_DIRECT_RUN_ZERO_COPY=0
# Callback-stage telemetry is collected by the instrumented image; keep its optional reorder off.
TON_NATIVE_EAGER_COLLATOR_CALLBACK=0
# Default-off CellDb timing probe. The unsafe ceiling also requires this profile flag.
TON_NATIVE_CELLDB_DURABILITY_PROFILE=0
TON_NATIVE_CELLDB_UNSAFE_SYNC_FALSE=0
# Reuse validation's exact next-state root during acceptance; benchmark before enabling.
TON_NATIVE_VALIDATED_STATE_HANDOFF=0
# Exact-state configuration cache; set 0 only for a matched A/B control.
TON_NATIVE_ADMISSION_CONFIG_CACHE=1
# Selected desktop improvements, enabled for this server benchmark.
# Require a published TON revision containing both features; measure the existing
# eight-lane chain separately before attributing a production TPS improvement.
TON_NATIVE_CANDIDATE_METADATA_PROJECTION=1
TON_OVERLAY_LOCAL_SIGNATURE_REUSE=1
# Retain the tested diagnostic setting and leave unsuccessful candidates off.
TON_NATIVE_RECONCILIATION_PROFILE=1
TON_KEYRING_PREPARED_SIGNING=0
TON_NATIVE_ADMISSION_SHARD_SHARING=0
TON_NATIVE_ADMISSION_SNAPSHOT_REFRESH=0
# Bound admission actor turns only in an isolated scheduler-latency experiment.
TON_NATIVE_EXT_MESSAGE_POOL_MAILBOX_QUANTUM=0
# Conservative runtime cap from the observed transfer/account-size regression.
# It leaves over 1 MiB of serialized headroom at the worst observed account
# fanout and avoids wasting work on a suffix which cannot fit this profile.
TON_NATIVE_COLLATOR_QUEUE_LIMIT=18432
# Keep the existing two 512-message native transport fragments as the baseline.
TON_NATIVE_EXT_MSG_TRANSPORT_WINDOW=1024
# Default-off after measured regression; opt-in retention also requires pending producer work.
TON_NATIVE_CHECKPOINT_RETAIN_INGRESS=0
# Held default-off after the sustained A/B; only literal 1 selects the 20 ms experiment.
TON_NATIVE_POST_COMMIT_PACK_GRACE_20MS=0
TON_NATIVE_MEMPOOL_MAX_TTL=7200

NATIVE_TPS_INTERVAL_SECONDS=10
NATIVE_TPS_WORKCHAIN=0
NATIVE_TPS_PRINT_LIMIT=1000000
NATIVE_TPS_LITE_TIMEOUT_SECONDS=10
NATIVE_TPS_LITESERVER_ADDR=127.0.0.1:40004
NATIVE_TPS_VERBOSE_BLOCKS=0
NATIVE_TPS_BACKFILL_BLOCKS=0
NATIVE_TPS_MAX_BLOCKS_PER_INTERVAL=1000

# faucet settings
# enable captcha to secure faucet
FAUCET_USE_RECAPTCHA=false
# google reCaptcha v2, required then FAUCET_USE_RECAPTCHA=true
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET=
# if true generates new addresses only in masterchain (-1)
FAUCET_MASTERCHAIN_ONLY=false
# expiration of faucet request, secs
FAUCET_REQUEST_EXPIRATION_PERIOD=30
# amount of toncoins to giveaway
FAUCET_SINGLE_GIVEAWAY=10

# data-generator settings
# period of activity generation
PERIOD=5

# ton-http-api settings
# log level, one of trace, debug, info, warning, error, critical
THACPP_LOG_LEVEL=warning
# log format (`tskv`, `ltsv`, `json`)
THACPP_LOG_FORMAT=json
# number of workers
THACPP_MAIN_WORKER_THREADS=2
THACPP_TONLIB_THREADS=2

# indexer settings
# postgres settings
POSTGRES_USER=postgres
POSTGRES_DB=ton_index
POSTGRES_PASSWORD=PostgreSQL1234
# postgres exposed port
POSTGRES_PUBLISH_PORT=5432
# number of events classifier workers
TON_CLASSIFIER_WORKERS=2
# masterchain block seqno for indexer to start with
TON_WORKER_FROM=1

# session-stats settings
SESSION_STATS_IMAGE=ghcr.io/neodix42/ton-session-stats:side
SESSION_STATS_HTTP_PORT=18000
SESSION_STATS_TITLE=Native TON sidechain session stats
# Session Stats reads only the private RAM daemon's volume tree.
TON_WORK_HOST_DIR=
SESSION_STATS_FILENAME=log.session-stats
HOST_FS_ROOT=${NATIVE_RAM_ROOT}
# One or more Docker volume names containing active session stats files.
# Comma-separated values are supported.
TON_WORK_DOCKER_VOLUME=mylocalton-desktop_ton-db-val0
DOCKER_VOLUMES_HOST_DIR=${NATIVE_RAM_ROOT}/data/volumes
SESSION_STATS_DIR_HOST_DIR=
SESSION_STATS_ARCHIVE_DIR=
SESSION_STATS_SELF=local-validator
SESSION_STATS_WORK_TIME_STATS_BY_SOURCE_LIST=
# Corroborating telemetry should not compete heavily with the validator.
SESSION_STATS_GUNICORN_WORKERS=1
SESSION_STATS_IMPORT_INTERVAL_SECONDS=15
SESSION_STATS_IMPORT_LAG_SECONDS=2
SESSION_STATS_IMPORT_LOOKBACK_SECONDS=1800
SESSION_STATS_PRIVATE_NET=true
SESSION_STATS_NATIVE_FAST_PATH=true
SESSION_STATS_NATIVE_WORKCHAIN=0
SESSION_STATS_ALLOW_UNCORRELATED_CANDIDATES=false
SESSION_STATS_VALIDATE_ACTUAL_WORK_TIME=true
SESSION_STATS_WORK_TIME_STATS_BY_SOURCE=true

MLT_IMAGE=ghcr.io/neodix42/mylocalton-docker
MLT_DATA_IMAGE=ghcr.io/neodix42/mylocalton-docker-data
MLT_FAUCET_IMAGE=ghcr.io/neodix42/mylocalton-docker-faucet
MLT_CONFIG_UPDATE_IMAGE=ghcr.io/neodix42/mylocalton-docker-config-update
MLT_EXPLORER_IMAGE=ghcr.io/neodix42/mylocalton-docker-explorer
MLT_LITE_SERVER_IMAGE=ghcr.io/neodix42/mylocalton-docker-lite-server
MLT_TIME_MACHINE_IMAGE=ghcr.io/neodix42/mylocalton-docker-time-machine
MLT_ADMIN_PORTAL_IMAGE=ghcr.io/neodix42/mylocalton-docker-admin-portal
