# Laptop-native benchmark profile.
# Sized for Docker Desktop with 16 vCPU and ~5.78 GiB container RAM.
# Short smoke/saturation results are not comparable to bare-metal results.

# Compose profiles are introduced to deploy only necessary services
# Several comma-separated profiles may be specified. Available profiles:
# (leave empty if you want only genesis to be started, on port 40001/udp)
# - blockchain-explorer: enables default native TON blockchain explorer ion port 8080
# - lite-server: deploys external TON lite-server, by default one runs as embedded inside genesis container on port 40004 (tcp)
# - time-machine: deploys Time Machine service on port 8083
# - admin-portal: deploys admin portal service on port 8085
# - config-update: deploys config update web UI on port 8084
# - faucet: deploys faucet service to get coins to some special address on port 88
# - data: deploys service that generates some activity with TON wallets, Jettons and NFTs on port 99
# - validators-N: launches N validators in addition to genesis node
# - indexer: deploys TON Center API v3
# - indexer-minimal: deploys API v3 without trace classifier
# - ton-http-api-v2: deploys TON Center HTTP API v3
# - session-stats: deploys session-stats on port 18000
# - native-load-generator: runs persistent native load in a separate container
COMPOSE_PROFILES=

# By default MyLocalTon is built based on the latest TON blockchain code base master branch.
# You can set it to testnet in order to run MyLocalTon based on TON testnet code base.
# You can set any other branch too, but check if this branch exists in the configured TON image repository.
TON_BRANCH=latest
# By default TON Docker image is taken from ghcr.io/corton-nommander/ton:${TON_BRANCH}.
# You can replace it with your own locally built one or with one located in your docker registry.
# For building custom MyLocalTon refer to custom-MyLocalTon.sh bash script.
TON_IMAGE=ghcr.io/corton-nommander/ton

# Host publication addresses. The portable profile preserves the historical
# all-interface behavior; use loopback/private addresses on an exposed host.
LITESERVER_BIND_IP=127.0.0.1
MANAGEMENT_BIND_IP=127.0.0.1
UI_BIND_IP=127.0.0.1
SESSION_STATS_BIND_IP=127.0.0.1
FILE_SERVER_BIND_IP=127.0.0.1

# Optional absolute path to a dedicated validator NVMe directory. Empty keeps
# the portable Docker named volume `ton-db-val0`.
TON_DB_VAL0_HOST_DIR=

# resources quotes
# specify CPU quotes for efficiency, 1.0 = 1 vCPU
# use values <= 1.0 for laptop battery efficiency
# use values >= 4.0 for better performance
GENESIS_CPU_QUOTE=10
VALIDATOR_CPU_QUOTE=10
INDEXER_CPU_QUOTE=1
CLASSIFIER_CPU_QUOTE=1
# Optional CPU pinning. Leave empty for the portable/laptop profile.
GENESIS_CPUSET=
NATIVE_LOAD_CPU_QUOTE=4
NATIVE_LOAD_CPUSET=
NATIVE_LOAD_MEMORY_LIMIT=512m
SESSION_STATS_CPU_QUOTE=1
SESSION_STATS_CPUSET=

# Genesis settings
HEALTHCHECK_INTERVAL=15s
# used to generate  external.global.config.json that allows remote users to connect to lite-server via public IP
EXTERNAL_IP=
# period of elections validators, sec
VALIDATION_PERIOD=1200
# generate only masterchain
MASTERCHAIN_ONLY=false
# verbosity level, 1 - error, 2 - warning, 3 - info, 4 - debug
GENESIS_VERBOSITY=1
VALIDATOR_VERBOSITY=1
# Log resource snapshots while long Fift zero-state commands are running.
GENESIS_HEARTBEAT_SECONDS=15
# enable embedded http server
EMBEDDED_FILE_HTTP_SERVER=false
EMBEDDED_FILE_HTTP_SERVER_PORT=8888
# validator engine parameters
CUSTOM_PARAMETERS="--state-ttl 86400 --archive-ttl 86400 -f /usr/share/ton/smartcont/ --session-logs /var/ton-work/db/log.session-stats --threads 9 --mempool-num 32768 --celldb-cache-size 134217728 --disable-rocksdb-stats --disable-state-serializer --broadcast-speed-catchain 64"
CUSTOM_CONFIG_SMC_URL=
# tvm version capability
VERSION_CAPABILITIES=14
# Reserved future v5 NativeTransferRun activation. Leave disabled for the
# current v14 chain. Enabling it requires a fresh zero state and matching
# v5-capable validator and generator images.
NATIVE_TRANSFER_RUNS_ENABLED=0
NATIVE_TRANSFER_RUNS_GLOBAL_VERSION=15
NATIVE_TRANSFER_RUNS_CAPABILITY=1024
# Reserved Phase-A native payment lanes. The fixed two-lane profile is opt-in
# and must be initialized through a fresh benchmark cycle.
NATIVE_PAYMENT_LANES_ENABLED=0
NATIVE_PAYMENT_LANES_GLOBAL_VERSION=16
NATIVE_PAYMENT_LANES_CAPABILITY=2048
NATIVE_PAYMENT_LANE_DEPTH=1
NATIVE_PAYMENT_LANE_WALLET_RETRIES=128
NATIVE_PAYMENT_LANE_WALLET_PARALLELISM=1
 # read about other parameters here https://github.com/neodix42/mylocalton-docker/wiki/Genesis-setup-parameters
GLOBAL_ID=-217
MAX_VALIDATORS=1000
MAX_MAIN_VALIDATORS=100
MIN_VALIDATORS=1
MIN_STAKE=1000000
MAX_STAKE=1000000000
MAX_FACTOR=10
MIN_TOTAL_STAKE=10000
ELECTION_START_BEFORE=900
ELECTION_END_BEFORE=300
ELECTION_STAKE_FROZEN=180
ORIGINAL_VALIDATOR_SET_VALID_FOR=120
ACTUAL_MIN_SPLIT=0
MIN_SPLIT=0
MAX_SPLIT=0
CELL_PRICE=100000
CELL_PRICE_MC=1000000
GAS_PRICE=1000
GAS_PRICE_MC=10000
SIMPLE_FAUCET_INITIAL_BALANCE=1000000
HIGHLOAD_FAUCET_INITIAL_BALANCE=1000000
DATA_FAUCET_INITIAL_BALANCE=1000000
VALIDATOR_0_INITIAL_BALANCE=500000000
VALIDATOR_1_INITIAL_BALANCE=500000000
VALIDATOR_2_INITIAL_BALANCE=500000000
VALIDATOR_3_INITIAL_BALANCE=500000000
VALIDATOR_4_INITIAL_BALANCE=500000000
VALIDATOR_5_INITIAL_BALANCE=500000000
BIT_PRICE_PER_SECOND=1
CELL_PRICE_PER_SECOND=500
BIT_PRICE_PER_SECOND_MC=1000
CELL_PRICE_PER_SECOND_MC=500000
CRITICAL_PARAM_MIN_WINS=4
CRITICAL_PARAM_MAX_LOSSES=2
SIMPLEX_TARGET_RATE_MS=300
SIMPLEX_SLOTS_PER_LEADER_WINDOW=4
SIMPLEX_FIRST_BLOCK_TIMEOUT_MS=400
SIMPLEX_MAX_LEADER_WINDOW_DESYNC=700
# Opt-in benchmark mode: produce candidates immediately instead of using the
# Work-driven native shardchain mode; the masterchain remains normally paced.
TON_SIMPLEX_MAX_TPS=1
# Failure/cancellation budget for one work-driven candidate; never a block interval.
TON_SIMPLEX_MAX_TPS_CANDIDATE_TIMEOUT_MS=5000

PROTO_VERSION=5

VALIDATORS_MASTERCHAIN_NUM=1
VALIDATORS_PER_SHARD=1

BLOCK_LIMIT_MULTIPLIER=1
BLOCK_SIZE_UNDERLOAD_KB=1024
BLOCK_SIZE_SOFT_KB=4096
BLOCK_SIZE_HARD_KB=5120
BLOCK_GAS_LIMIT_UNDERLOAD=2000000
BLOCK_GAS_LIMIT_SOFT=10000000
BLOCK_GAS_LIMIT_HARD=20000000

SPAM_RUN=0
SPAM_CHAINS=10
SPAM_HOPS=65535
SPAM_SPLIT_HOPS=7
SPAM_DURATION_MINUTES=300

NATIVE_SPAM_RUN=0
NATIVE_SPAM_MODE=pipeline
NATIVE_SPAM_SOURCES=1024
NATIVE_SPAM_DURATION_SECONDS=600
NATIVE_SPAM_ROUNDS=0
NATIVE_SPAM_AMOUNT=0.000000001
NATIVE_SPAM_FEE=0
NATIVE_SPAM_TOPUP_AMOUNT=10
NATIVE_SPAM_PARALLELISM=64
NATIVE_SPAM_TRANSFER_TIMEOUT_SECONDS=120
NATIVE_SPAM_CONFIRM_TIMEOUT_SECONDS=30
NATIVE_SPAM_TOPUP_TIMEOUT_SECONDS=180
NATIVE_SPAM_FORCE_TOPUP=0
# Log native genesis wallet progress after this many source/destination sets.
NATIVE_SPAM_GENESIS_PROGRESS_EVERY=128

NATIVE_SPAM_KEEP_ARTIFACTS=0
NATIVE_SPAM_CONFIRM_PARALLELISM=64
NATIVE_SPAM_CONFIRM_POLL_SECONDS=0.2
NATIVE_SPAM_CONFIRM_MODE=optimistic
NATIVE_SPAM_PROGRESS_INTERVAL_SECONDS=5

# Separate persistent load generator. Start with:
# docker compose --profile native-load-generator up native-load-generator
NATIVE_LOAD_SOURCES=1024
NATIVE_LOAD_CONNECTIONS=4
NATIVE_LOAD_SIGNERS=4
NATIVE_LOAD_INFLIGHT=4096
NATIVE_LOAD_SUBMIT_BATCH_SIZE=32
NATIVE_LOAD_SUBMIT_SOURCE_RUN_SIZE=8
# Future source-signed v5 run mode. Kept off while the protocol gate is off.
NATIVE_LOAD_NATIVE_TRANSFER_RUNS=0
NATIVE_LOAD_NATIVE_TRANSFER_RUN_SIZE=16
NATIVE_LOAD_PAYMENT_LANE_DEPTH=0
NATIVE_LOAD_PAYMENT_LANE_READY_TIMEOUT_SECONDS=360
NATIVE_LOAD_PAYMENT_LANE_READY_POLL_SECONDS=2
NATIVE_LOAD_PAYMENT_LANE_READY_STABLE_OBSERVATIONS=2
NATIVE_LOAD_PAYMENT_LANE_LITESERVER_TIMEOUT_SECONDS=5
NATIVE_LOAD_SUBMIT_COALESCE_MS=2
NATIVE_LOAD_MAX_CANONICAL_BACKLOG=8192
NATIVE_LOAD_MAX_SOURCE_CANONICAL_BACKLOG=8
NATIVE_LOAD_DURATION_SECONDS=60
NATIVE_LOAD_AMOUNT=0.000000001
NATIVE_LOAD_FEE=0
NATIVE_LOAD_START_NONCE=0
NATIVE_LOAD_QUERY_TIMEOUT_SECONDS=10
NATIVE_LOAD_REPORT_INTERVAL_SECONDS=1
NATIVE_LOAD_TARGET_TPS=5000
NATIVE_LOAD_RAMP_SECONDS=10
NATIVE_LOAD_WARMUP_SECONDS=10
NATIVE_LOAD_DRAIN_TIMEOUT_SECONDS=120
NATIVE_LOAD_VALID_FOR_SECONDS=600
NATIVE_LOAD_WORKERS=4
NATIVE_LOAD_MAX_RETRIES=3
NATIVE_LOAD_RETRY_BACKOFF_MS=10
NATIVE_LOAD_AUTO_NONCE=1
NATIVE_LOAD_ADAPTIVE_INFLIGHT=1
NATIVE_LOAD_ADAPTIVE_INITIAL_RTT_SECONDS=0.02
NATIVE_LOAD_SOURCE_OFFSET=0
NATIVE_LOAD_FINALITY_POLL_SECONDS=5
NATIVE_LOAD_FINALITY_SAMPLE_SOURCES=64
NATIVE_LOAD_CANONICAL_POLL_SECONDS=0.5
NATIVE_LOAD_CANONICAL_QUERY_TIMEOUT_SECONDS=30
NATIVE_LOAD_CANONICAL_RETRY_LIMIT=5
NATIVE_LOAD_CANONICAL_RETRY_BACKOFF_SECONDS=0.25
NATIVE_LOAD_CANONICAL_RETRY_MAX_BACKOFF_SECONDS=5
NATIVE_LOAD_REPAIR_COOLDOWN_SECONDS=5
NATIVE_LOAD_CANONICAL_BLOCK_FOLLOWER=1

# Native signature/state workers. Keep this low on a laptop; raise it on bare metal.
TON_NATIVE_EXECUTOR_THREADS=4
# Validator-side native admission/collation safety limits.
TON_NATIVE_COLLATOR_QUEUE_LIMIT=16384
TON_NATIVE_MEMPOOL_MAX_TTL=600

NATIVE_TPS_INTERVAL_SECONDS=10
NATIVE_TPS_WORKCHAIN=0
NATIVE_TPS_PRINT_LIMIT=1000000
NATIVE_TPS_LITE_TIMEOUT_SECONDS=10
NATIVE_TPS_LITESERVER_ADDR=127.0.0.1:40004
NATIVE_TPS_VERBOSE_BLOCKS=0
NATIVE_TPS_BACKFILL_BLOCKS=0
NATIVE_TPS_MAX_BLOCKS_PER_INTERVAL=1000

# faucet settings
# enable captcha to secure faucet
FAUCET_USE_RECAPTCHA=false
# google reCaptcha v2, required then FAUCET_USE_RECAPTCHA=true
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET=
# if true generates new addresses only in masterchain (-1)
FAUCET_MASTERCHAIN_ONLY=false
# expiration of faucet request, secs
FAUCET_REQUEST_EXPIRATION_PERIOD=30
# amount of toncoins to giveaway
FAUCET_SINGLE_GIVEAWAY=10

# data-generator settings
# period of activity generation
PERIOD=5

# ton-http-api settings
# log level, one of trace, debug, info, warning, error, critical
THACPP_LOG_LEVEL=warning
# log format (`tskv`, `ltsv`, `json`)
THACPP_LOG_FORMAT=json
# number of workers
THACPP_MAIN_WORKER_THREADS=2
THACPP_TONLIB_THREADS=2

# indexer settings
# postgres settings
POSTGRES_USER=postgres
POSTGRES_DB=ton_index
POSTGRES_PASSWORD=PostgreSQL1234
# postgres exposed port
POSTGRES_PUBLISH_PORT=5432
# number of events classifier workers
TON_CLASSIFIER_WORKERS=2
# masterchain block seqno for indexer to start with
TON_WORKER_FROM=1

# session-stats settings
SESSION_STATS_IMAGE=ghcr.io/neodix42/ton-session-stats:side
SESSION_STATS_HTTP_PORT=18000
SESSION_STATS_TITLE=Native TON sidechain session stats
TON_WORK_HOST_DIR=
SESSION_STATS_FILENAME=log.session-stats
HOST_FS_ROOT=/
# One or more Docker volume names containing active session stats files.
# Comma-separated values are supported.
TON_WORK_DOCKER_VOLUME=mylocalton-docker_ton-db-val0
DOCKER_VOLUMES_HOST_DIR=/var/lib/docker/volumes
SESSION_STATS_DIR_HOST_DIR=
SESSION_STATS_ARCHIVE_DIR=
SESSION_STATS_SELF=local-validator
SESSION_STATS_WORK_TIME_STATS_BY_SOURCE_LIST=
SESSION_STATS_IMPORT_INTERVAL_SECONDS=5
SESSION_STATS_IMPORT_LAG_SECONDS=2
SESSION_STATS_IMPORT_LOOKBACK_SECONDS=600
SESSION_STATS_PRIVATE_NET=true
SESSION_STATS_NATIVE_FAST_PATH=true
SESSION_STATS_NATIVE_WORKCHAIN=0
SESSION_STATS_ALLOW_UNCORRELATED_CANDIDATES=false
SESSION_STATS_VALIDATE_ACTUAL_WORK_TIME=true
SESSION_STATS_WORK_TIME_STATS_BY_SOURCE=true

MLT_IMAGE=ghcr.io/neodix42/mylocalton-docker
MLT_DATA_IMAGE=ghcr.io/neodix42/mylocalton-docker-data
MLT_FAUCET_IMAGE=ghcr.io/neodix42/mylocalton-docker-faucet
MLT_CONFIG_UPDATE_IMAGE=ghcr.io/neodix42/mylocalton-docker-config-update
MLT_EXPLORER_IMAGE=ghcr.io/neodix42/mylocalton-docker-explorer
MLT_LITE_SERVER_IMAGE=ghcr.io/neodix42/mylocalton-docker-lite-server
MLT_TIME_MACHINE_IMAGE=ghcr.io/neodix42/mylocalton-docker-time-machine
MLT_ADMIN_PORTAL_IMAGE=ghcr.io/neodix42/mylocalton-docker-admin-portal

# Explicit zero-state provisioning for the 1,024 source/destination pairs.
NATIVE_SPAM_GENESIS_ACCOUNT_LIMIT=2048
NATIVE_SPAM_GENESIS_SOURCE_LIMIT=1024
NATIVE_SPAM_GENESIS_DESTINATIONS=1
NATIVE_SPAM_GENESIS_SOURCES=1024
NATIVE_SPAM_GENESIS_SOURCE_BALANCE=10.000000000
NATIVE_SPAM_GENESIS_DEST_BALANCE=0.000000001
NATIVE_SPAM_POST_GENESIS_TOPUPS=0

# Reduce Session Stats process count and memory pressure.
SESSION_STATS_GUNICORN_WORKERS=1
